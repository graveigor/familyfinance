# Copie para .env e ajuste. Gere os segredos com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

NODE_ENV=development
PORT=3333
HOST=0.0.0.0

DATABASE_URL="postgresql://usuario@localhost:5432/controle_gastos?schema=public"

# Opcional: sem isto o servidor gera e guarda o seu no banco.
# JWT_SEGREDO="troque-por-um-segredo-longo-e-aleatorio"
# JWT_SEGREDO_REFRESH="troque-por-outro-segredo-longo-e-aleatorio"

# OBRIGATÓRIA. Cifra nome, e-mail e comprovantes no banco. 64 caracteres hex,
# gerados com o comando lá de cima.
#
# Esta não tem cópia guardada no banco, ao contrário das do JWT: se ficasse
# lá, viajaria junto com os dados que ela protege num vazamento. Guarde-a
# também fora daqui — perdida a chave, nome, e-mail e comprovantes ficam
# ilegíveis e ninguém consegue entrar.
CHAVE_CRIPTOGRAFIA="troque-por-64-caracteres-hexadecimais-aleatorios---------------"
JWT_EXPIRA_EM=15m
JWT_REFRESH_EXPIRA_EM=30d

# Origens liberadas no CORS, separadas por vírgula. "*" libera todas.
CORS_ORIGENS=*
