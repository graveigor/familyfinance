# Copie para .env.test antes de rodar `npm test`.
#
# Aponta para um banco SEPARADO do de desenvolvimento: a suíte trunca as
# tabelas entre os casos, e apontar para o banco errado apaga o seu trabalho.
#
# No macOS com Homebrew, o usuário do Postgres é o seu usuário do sistema —
# troque `postgres` abaixo se for o seu caso.

NODE_ENV=test
PORT=3334
DATABASE_URL="postgresql://postgres@localhost:5432/controle_gastos_test?schema=public"

# Valores fixos e descartáveis: são só para os testes assinarem token.
JWT_SEGREDO="segredo-apenas-para-testes-1234567890"
JWT_SEGREDO_REFRESH="segredo-refresh-apenas-para-testes-123456"
JWT_EXPIRA_EM=15m
JWT_REFRESH_EXPIRA_EM=30d
CORS_ORIGENS=*
