// Modelo de dados do controle de gastos.
// Regra inegociável: dinheiro é Int em centavos. Nenhum campo Float/Decimal.

generator client {
  provider      = "prisma-client-js"
  // `rhel-openssl-3.0.x` é o runtime das funções serverless da Vercel; sem ele
  // o Prisma sobe sem o motor de consulta e quebra só em produção.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Household {
  id           String        @id @default(uuid())
  nome         String
  criadoEm     DateTime      @default(now())
  membros      User[]
  gastos       Gasto[]
  categorias   Categoria[]
  convites     Convite[]
  importacoes  Importacao[]
  recorrencias Recorrencia[]
}

model User {
  id           String        @id @default(uuid())
  nome         String
  email        String        @unique
  senhaHash    String
  papel        Papel         @default(MEMBRO)
  householdId  String
  household    Household     @relation(fields: [householdId], references: [id])
  gastos       Gasto[]
  convites     Convite[]     @relation("ConvitesCriados")
  recorrencias Recorrencia[]
  criadoEm     DateTime      @default(now())

  @@index([householdId])
}

model Categoria {
  id           String        @id @default(uuid())
  nome         String
  icone        String
  cor          String
  householdId  String
  household    Household     @relation(fields: [householdId], references: [id])
  gastos       Gasto[]
  recorrencias Recorrencia[]

  // Duas categorias com o mesmo nome na mesma casa só confundem o usuário.
  @@unique([householdId, nome])
}

model Gasto {
  id                 String         @id @default(uuid())
  descricao          String
  valorCentavos      Int
  data               DateTime       @db.Date
  formaPagamento     FormaPagamento @default(CARTAO)
  observacao         String?
  categoriaId        String?
  categoria          Categoria?     @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  userId             String
  user               User           @relation(fields: [userId], references: [id])
  householdId        String
  household          Household      @relation(fields: [householdId], references: [id])
  origemImportacaoId String?
  importacao         Importacao?    @relation(fields: [origemImportacaoId], references: [id])

  // Tabela à parte de propósito: assim listar gastos nunca arrasta as imagens
  // junto. Ver o comentário em `model Comprovante`.
  comprovante Comprovante?

  // Quando o gasto nasceu de uma recorrência, guardamos a origem para não
  // gerar o mesmo lançamento duas vezes e para o usuário saber de onde veio.
  recorrenciaId String?
  recorrencia   Recorrencia? @relation(fields: [recorrenciaId], references: [id], onDelete: SetNull)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([householdId, data])
  @@index([householdId, userId])
  @@index([categoriaId])
}

model Importacao {
  id               String           @id @default(uuid())
  nomeArquivo      String
  status           StatusImportacao @default(PENDENTE)
  totalLinhas      Int              @default(0)
  linhasImportadas Int              @default(0)
  householdId      String
  household        Household        @relation(fields: [householdId], references: [id])
  criadoEm         DateTime         @default(now())
  gastos           Gasto[]

  // Planilha já lida, guardada entre as etapas de conferência para que trocar
  // o mapeamento das colunas não obrigue a enviar o arquivo de novo.
  // Limpa ao confirmar ou cancelar — não guardamos arquivo do usuário à toa.
  dadosBrutos Json?

  @@index([householdId, criadoEm])
}

model Convite {
  id          String    @id @default(uuid())
  codigo      String    @unique
  householdId String
  household   Household @relation(fields: [householdId], references: [id])
  criadoPorId String
  criadoPor   User      @relation("ConvitesCriados", fields: [criadoPorId], references: [id])
  expiraEm    DateTime
  usadoEm     DateTime?
  criadoEm    DateTime  @default(now())

  @@index([householdId])
}

/// Comprovante (foto ou PDF) de um gasto.
///
/// Fica em tabela separada, e não numa coluna do gasto, porque o Prisma traz
/// todas as colunas escalares em cada consulta: uma coluna de imagem no gasto
/// faria a lista do mês baixar todas as fotos junto.
///
/// E fica no banco, e não em disco, porque o servidor roda sem disco gravável
/// (função serverless). Um lugar só, um caminho de código só.
model Comprovante {
  id       String   @id @default(uuid())
  gastoId  String   @unique
  gasto    Gasto    @relation(fields: [gastoId], references: [id], onDelete: Cascade)
  /// Tipo do arquivo (image/jpeg, application/pdf...), para devolver no download.
  tipo     String
  dados    Bytes
  criadoEm DateTime @default(now())
}

/// Gasto que se repete todo mês (aluguel, internet, mensalidade).
/// Nada é criado automaticamente em segundo plano: os lançamentos do mês são
/// gerados quando alguém abre o app, de forma idempotente.
model Recorrencia {
  id              String         @id @default(uuid())
  descricao       String
  valorCentavos   Int
  /// Dia do mês (1-31). Quando o mês não tem esse dia, cai no último.
  diaDoMes        Int
  formaPagamento  FormaPagamento @default(OUTRO)
  observacao      String?
  categoriaId     String?
  categoria       Categoria?     @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  userId          String
  user            User           @relation(fields: [userId], references: [id])
  householdId     String
  household       Household      @relation(fields: [householdId], references: [id])
  ativa           Boolean        @default(true)
  /// Primeiro mês em que vale, e último (opcional).
  inicioEm        DateTime       @db.Date
  fimEm           DateTime?      @db.Date
  /// "aaaa-mm" do último mês já gerado — é o que torna a geração idempotente.
  ultimoMesGerado String?
  criadoEm        DateTime       @default(now())
  atualizadoEm    DateTime       @updatedAt
  gastos          Gasto[]

  @@index([householdId, ativa])
}

enum Papel {
  ADMIN
  MEMBRO
}

enum FormaPagamento {
  CARTAO
  DINHEIRO
  PIX
  BOLETO
  OUTRO
}

enum StatusImportacao {
  PENDENTE
  CONFIRMADA
  CANCELADA
}
