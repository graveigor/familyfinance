// Modelo de dados do controle de gastos.
// Regra inegociável: dinheiro é Int em centavos. Nenhum campo Float/Decimal.

generator client {
  provider      = "prisma-client-js"
  // `rhel-openssl-3.0.x` é o runtime das funções serverless da Vercel; sem ele
  // o Prisma sobe sem o motor de consulta e quebra só em produção.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Household {
  id       String   @id @default(uuid())
  nome     String
  /// Moeda do grupo (BRL, USD). Os valores são centavos dessa moeda — trocar
  /// aqui não converte nada, só muda como o número aparece.
  moeda    String   @default("BRL")
  criadoEm DateTime @default(now())

  /// Quem criou o grupo. Nulo nos grupos anteriores ao campo.
  criadoPorId String?
  criadoPor   User?   @relation("GruposCriados", fields: [criadoPorId], references: [id], onDelete: SetNull)

  /// Quem participa. `membros` são os que estão com este grupo ATIVO agora.
  participacoes Participacao[]
  membros       User[]
  gastos       Gasto[]
  receitas     Receita[]
  categorias   Categoria[]
  cartoes      Cartao[]
  convites     Convite[]
  importacoes  Importacao[]
  recorrencias Recorrencia[]
  metas        Meta[]
}

model User {
  id String @id @default(uuid())

  /// Nome e e-mail ficam cifrados (AES-256-GCM, ver `servicos/criptografia.ts`).
  /// A chave mora no ambiente, não aqui: um dump deste banco não abre nenhum
  /// dos dois.
  nome  String
  email String

  /// Por onde o login acha a conta. O e-mail cifrado muda a cada escrita (IV
  /// novo), então não dá para procurar por ele; este HMAC é estável e, sem a
  /// chave, não volta ao endereço.
  ///
  /// A unicidade vive aqui — e não em `email` — justamente porque duas cifras
  /// do mesmo e-mail são bytes diferentes, e o banco as aceitaria como contas
  /// distintas.
  emailIndice String @unique

  senhaHash String

  /// Quando a senha mudou pela última vez. Todo token emitido antes disso
  /// deixa de valer — é o que faz trocar a senha derrubar as sessões abertas,
  /// inclusive a de quem entrou sem permissão. Ver `servicos/tokens.ts`.
  senhaAlteradaEm DateTime @default(now())

  papel Papel @default(MEMBRO)

  /// Quando ligado, os lançamentos desta pessoa ficam visíveis para o grupo.
  /// Desligado por padrão: dinheiro é assunto privado até alguém decidir o
  /// contrário. Quem não compartilha continua vendo só o que é seu.
  compartilhaGastos Boolean @default(false)

  /// Grupo ATIVO: onde os lançamentos entram e o que as telas mostram.
  /// A lista completa de grupos da pessoa está em `Participacao`.
  householdId String
  household   Household @relation(fields: [householdId], references: [id])

  /// Papel no grupo ativo. Cópia do que vale em `Participacao`, mantida em dia
  /// por `ativarGrupo` — evita uma consulta a mais em toda requisição.
  participacoes  Participacao[]
  gruposCriados  Household[]   @relation("GruposCriados")
  gastos         Gasto[]
  receitas       Receita[]
  convites       Convite[]     @relation("ConvitesCriados")
  recorrencias   Recorrencia[]
  metas          Meta[]
  pedidosDeSenha PedidoDeSenha[]
  criadoEm       DateTime      @default(now())

  @@index([householdId])
}

/// De quais grupos a pessoa participa. O grupo ativo é `User.householdId`.
model Participacao {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  papel       Papel     @default(MEMBRO)
  criadoEm    DateTime  @default(now())

  @@unique([userId, householdId])
  @@index([householdId])
}

model Categoria {
  id    String @id @default(uuid())
  nome  String
  icone String
  cor   String

  /// Para que serve esta categoria. "Salário" não pode aparecer no seletor de
  /// um gasto, nem "Mercado" no de uma receita.
  tipo TipoDeLancamento @default(DESPESA)

  householdId  String
  household    Household     @relation(fields: [householdId], references: [id])
  gastos       Gasto[]
  receitas     Receita[]
  recorrencias Recorrencia[]

  // Duas categorias com o mesmo nome na mesma casa só confundem o usuário.
  // O tipo entra na chave: "Outros" existe dos dois lados sem conflito.
  @@unique([householdId, nome, tipo])
}

/// Meio de pagamento com nome próprio: "Itaú", "Bradesco", "Vale-refeição".
///
/// Existe separado de `FormaPagamento` porque a pergunta que a família faz é
/// "quanto foi no cartão do Itaú?", e não "quanto foi no crédito". O apelido é
/// livre justamente por isso — quem cadastra escolhe como chama no dia a dia.
model Cartao {
  id           String        @id @default(uuid())
  nome         String
  tipo         TipoCartao    @default(CREDITO)
  cor          String        @default("#334155")

  /// Dia em que a fatura fecha e dia em que ela vence (1–31).
  ///
  /// Opcionais: cartão de débito não tem fatura, e os cartões cadastrados
  /// antes disso existir não têm como adivinhar. Sem os dois, o app continua
  /// funcionando — só não mostra a previsão da fatura.
  diaFechamento Int?
  diaVencimento Int?

  householdId  String
  household    Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  gastos       Gasto[]
  recorrencias Recorrencia[]
  criadoEm     DateTime      @default(now())

  // Mesmo apelido no mesmo tipo só confunde; "Itaú" crédito e "Itaú" débito
  // continuam podendo coexistir.
  @@unique([householdId, nome, tipo])
  @@index([householdId])
}

model Gasto {
  id                 String         @id @default(uuid())
  descricao          String
  valorCentavos      Int
  data               DateTime       @db.Date
  formaPagamento     FormaPagamento @default(CARTAO)
  observacao         String?
  categoriaId        String?
  categoria          Categoria?     @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  cartaoId           String?
  cartao             Cartao?        @relation(fields: [cartaoId], references: [id], onDelete: SetNull)
  userId             String
  user               User           @relation(fields: [userId], references: [id])
  householdId        String
  household          Household      @relation(fields: [householdId], references: [id])
  origemImportacaoId String?
  importacao         Importacao?    @relation(fields: [origemImportacaoId], references: [id])

  // Tabela à parte de propósito: assim listar gastos nunca arrasta as imagens
  // junto. Ver o comentário em `model Comprovante`.
  comprovante Comprovante?

  // Quando o gasto nasceu de uma recorrência, guardamos a origem para não
  // gerar o mesmo lançamento duas vezes e para o usuário saber de onde veio.
  recorrenciaId String?
  recorrencia   Recorrencia? @relation(fields: [recorrenciaId], references: [id], onDelete: SetNull)

  /// Quando a conta foi marcada como paga. Nulo = lançada e ainda em aberto.
  ///
  /// Nasceu para as contas fixas, onde "já saiu do papel" e "já saiu da conta"
  /// são coisas diferentes: o lançamento existe no dia do vencimento, mas o
  /// pagamento pode atrasar. Vale para qualquer gasto — não há motivo para
  /// proibir marcar um gasto avulso.
  pagoEm DateTime?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([householdId, data])
  @@index([householdId, userId])
  @@index([categoriaId])
  @@index([cartaoId])
}

model Importacao {
  id               String           @id @default(uuid())
  nomeArquivo      String
  status           StatusImportacao @default(PENDENTE)
  totalLinhas      Int              @default(0)
  linhasImportadas Int              @default(0)
  householdId      String
  household        Household        @relation(fields: [householdId], references: [id])
  criadoEm         DateTime         @default(now())
  gastos           Gasto[]

  // Planilha já lida, guardada entre as etapas de conferência para que trocar
  // o mapeamento das colunas não obrigue a enviar o arquivo de novo.
  // Limpa ao confirmar ou cancelar — não guardamos arquivo do usuário à toa.
  dadosBrutos Json?

  @@index([householdId, criadoEm])
}

/// Meta conjunta do grupo ("Viagem de férias"), exibida no Hub da Família.
/// É o único dado financeiro visível a todos: os lançamentos de cada pessoa
/// são privados.
model Meta {
  id                String    @id @default(uuid())
  nome              String
  valorAlvoCentavos Int?
  householdId       String
  household         Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  criadoPorId       String
  criadoPor         User      @relation(fields: [criadoPorId], references: [id], onDelete: Cascade)
  criadoEm          DateTime  @default(now())

  @@index([householdId])
}

/// Pedido de troca de senha por código enviado no e-mail.
///
/// O código é guardado com hash, como senha: quem ler o banco não consegue
/// entrar na conta de ninguém. Vale por pouco tempo, uma vez só, e tem limite
/// de tentativas — é um segredo de 6 dígitos, então força bruta é o risco real.
model PedidoDeSenha {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codigoHash String
  expiraEm   DateTime
  usadoEm    DateTime?
  tentativas Int       @default(0)
  criadoEm   DateTime  @default(now())

  @@index([userId])
}

model Convite {
  id          String    @id @default(uuid())
  codigo      String    @unique
  householdId String
  household   Household @relation(fields: [householdId], references: [id])
  criadoPorId String
  criadoPor   User      @relation("ConvitesCriados", fields: [criadoPorId], references: [id])
  expiraEm    DateTime
  usadoEm     DateTime?
  criadoEm    DateTime  @default(now())

  @@index([householdId])
}

/// Comprovante (foto ou PDF) de um gasto.
///
/// Fica em tabela separada, e não numa coluna do gasto, porque o Prisma traz
/// todas as colunas escalares em cada consulta: uma coluna de imagem no gasto
/// faria a lista do mês baixar todas as fotos junto.
///
/// E fica no banco, e não em disco, porque o servidor roda sem disco gravável
/// (função serverless). Um lugar só, um caminho de código só.
model Comprovante {
  id       String   @id @default(uuid())
  gastoId  String   @unique
  gasto    Gasto    @relation(fields: [gastoId], references: [id], onDelete: Cascade)
  /// Tipo do arquivo (image/jpeg, application/pdf...), para devolver no download.
  tipo     String
  /// Cifrados (AES-256-GCM). É foto de nota fiscal: mostra onde a pessoa
  /// esteve, quando e quanto gastou. O tipo fica em claro porque é só o
  /// cabeçalho do download.
  dados    Bytes
  criadoEm DateTime @default(now())
}

/// Gasto que se repete todo mês (aluguel, internet, mensalidade).
/// Nada é criado automaticamente em segundo plano: os lançamentos do mês são
/// gerados quando alguém abre o app, de forma idempotente.
model Recorrencia {
  id String @id @default(uuid())

  /// Se este compromisso mensal gera um gasto ou uma receita. O motor de
  /// geração é o mesmo — idempotência, encaixe do dia 31, regra de não
  /// lançar no futuro — e repetir tudo isso para o salário seria uma segunda
  /// cópia das partes difíceis.
  tipo TipoDeLancamento @default(DESPESA)

  descricao       String
  valorCentavos   Int
  /// Dia do mês (1-31). Quando o mês não tem esse dia, cai no último.
  diaDoMes        Int
  formaPagamento  FormaPagamento @default(OUTRO)
  observacao      String?
  categoriaId     String?
  categoria       Categoria?     @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  cartaoId        String?
  cartao          Cartao?        @relation(fields: [cartaoId], references: [id], onDelete: SetNull)
  userId          String
  user            User           @relation(fields: [userId], references: [id])
  householdId     String
  household       Household      @relation(fields: [householdId], references: [id])
  ativa           Boolean        @default(true)
  /// Primeiro mês em que vale, e último (opcional).
  inicioEm        DateTime       @db.Date
  fimEm           DateTime?      @db.Date
  /// "aaaa-mm" do último mês já gerado — é o que torna a geração idempotente.
  ultimoMesGerado String?
  criadoEm        DateTime       @default(now())
  atualizadoEm    DateTime       @updatedAt
  gastos          Gasto[]
  receitas        Receita[]

  @@index([householdId, ativa])
}

/// O que entra: salário, freela, aluguel recebido, presente.
///
/// Tabela própria, e não uma coluna de sinal no `Gasto`. Todo `aggregate` e
/// `groupBy` de resumo soma `Gasto` sem filtrar nada: um campo de tipo faria
/// receita entrar em silêncio no "total de gastos" de cada tela, que é
/// exatamente a classe de erro que a auditoria de 2026-09 encontrou. Em tabela
/// separada, as consultas que já existem continuam certas por construção.
model Receita {
  id            String   @id @default(uuid())
  descricao     String
  valorCentavos Int
  data          DateTime @db.Date
  observacao    String?

  categoriaId String?
  categoria   Categoria? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  householdId String
  household   Household @relation(fields: [householdId], references: [id])

  /// Quando nasceu de uma receita fixa (salário), guarda a origem.
  recorrenciaId String?
  recorrencia   Recorrencia? @relation(fields: [recorrenciaId], references: [id], onDelete: SetNull)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([householdId, data])
  @@index([householdId, userId])
  @@index([categoriaId])
}

enum TipoDeLancamento {
  DESPESA
  RECEITA
}

/// Ajustes do servidor guardados no banco.
///
/// Existe por causa dos segredos que assinam o login: em vez de exigir que
/// quem publica o app crie e cole chaves no painel da hospedagem — passo fácil
/// de errar e de vazar —, o servidor gera as suas na primeira vez e guarda
/// aqui. Quem preferir controlar isso na mão continua podendo, definindo
/// JWT_SEGREDO e JWT_SEGREDO_REFRESH no ambiente: o ambiente tem prioridade.
model Configuracao {
  chave    String   @id
  valor    String
  criadoEm DateTime @default(now())
}

enum Papel {
  ADMIN
  MEMBRO
}

enum FormaPagamento {
  CARTAO
  DEBITO
  DINHEIRO
  PIX
  BOLETO
  OUTRO
}

enum TipoCartao {
  CREDITO
  DEBITO
}

enum StatusImportacao {
  PENDENTE
  CONFIRMADA
  CANCELADA
}
