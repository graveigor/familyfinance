{
  "expo": {
    "name": "Family Finance",
    "slug": "family-finance",
    "scheme": "familyfinance",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F8FAFC",
    "primaryColor": "#0F3A5F",
    "locales": {},
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F3A5F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.graveigor.controlegastos",
      "infoPlist": {
        "CFBundleDisplayName": "Family Finance",
        "CFBundleDevelopmentRegion": "pt_BR"
      }
    },
    "android": {
      "package": "com.graveigor.controlegastos",
      "adaptiveIcon": {
        "backgroundColor": "#0F3A5F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
